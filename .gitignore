# Server specific configs (Never overwrite live server configs)
wp-config.php
.htaccess

# Large backup archives
*.wpress
wp-content/ai1wm-backups/*.wpress
wp-content/upgrade/*
!wp-content/upgrade/index.php

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Log files
*.log

# Local credentials & agent configs
.agents/
*.env
git-credentials.json

# Page cache (generated at runtime)
wp-content/cache/

# User uploads (never wipe or overwrite server uploads)
wp-content/uploads/

